/* ai.wxss */
.page { min-height: 100vh; background-color: #F2F2F7; }
.ai-body { min-height: 60vh; }

/* 状态卡 */
.st-card { display: flex; align-items: center; padding: 26rpx 28rpx; }
.st-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; }
.st-body { flex: 1; min-width: 0; }
.st-title { font-size: 31rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.st-sub { font-size: 23rpx; color: rgba(60,60,67,0.5); margin-top: 4rpx; }

/* 厂商 chips */
.pv-scroll { white-space: nowrap; margin: 0 -32rpx; padding: 0 32rpx 4rpx; }
.pv-row { display: inline-flex; }
.pv-chip {
  padding: 16rpx 30rpx; border-radius: 999rpx; margin-right: 16rpx;
  background-color: #FFFFFF; color: rgba(60,60,67,0.75); font-size: 27rpx;
  border: 2rpx solid transparent; flex-shrink: 0;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03);
  transition: all .2s cubic-bezier(.34,1.56,.64,1);
}
.pv-chip.on { background-color: #007AFF; color: #FFFFFF; font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0,122,255,0.28); }

.tips-card { margin-top: 18rpx; padding: 20rpx 26rpx; border-radius: 22rpx;
  background-color: rgba(88,86,214,0.08); }
.tips-tx { font-size: 24rpx; color: #36349B; line-height: 1.5; }

.eye { font-size: 24rpx; color: #007AFF; padding: 10rpx 0 10rpx 20rpx; flex-shrink: 0; }
.res-tx { font-size: 26rpx; line-height: 1.5; }

/* 域名列表 */
.dom { display: flex; align-items: center; padding: 22rpx 30rpx; position: relative; }
.dom + .dom::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.dom-n { width: 180rpx; font-size: 27rpx; font-weight: 500; }
.dom-d { flex: 1; font-size: 25rpx; color: rgba(60,60,67,0.55); font-family: Menlo, Consolas, monospace; }

/* 模型选择 */
.mp-item { display: flex; align-items: center; padding: 24rpx 30rpx; position: relative; }
.mp-item + .mp-item::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.mp-n { flex: 1; font-size: 27rpx; font-family: Menlo, Consolas, monospace; }
.mp-check { color: #007AFF; font-size: 28rpx; font-weight: 700; }
