<view class="page">
  <navbar show-back="{{true}}" title="电子名片" />
  <view class="navbar-lg" style="padding-top:6rpx">
    <view class="eyebrow">让 HR 一眼记住你</view>
    <view class="t-large-title">电子名片</view>
  </view>

  <view class="sh-body">

    <!-- 名片预览 -->
    <view class="card-wrap">
      <view class="id-card" style="--acc:{{accent}}">
        <view class="id-circle c1"></view>
        <view class="id-circle c2"></view>
        <view class="id-brand">MAGIC RESUME · 电子名片</view>
        <view class="id-name">{{r.basic.name || '你的姓名'}}</view>
        <view class="id-title">{{r.basic.title || '求职意向'}}</view>
        <view class="id-status" wx:if="{{status}}">{{status}}</view>
        <view class="id-lines">
          <view class="id-line" wx:for="{{contacts}}" wx:key="k">
            <text class="id-ic">{{item.ic}}</text>
            <text class="id-tx">{{item.t}}</text>
          </view>
          <view class="id-empty" wx:if="{{!contacts.length}}">去编辑器填写联系方式</view>
        </view>
        <view class="id-foot">由 Magic Resume 本地生成 · 数据不上传</view>
      </view>

      <view class="id-actions">
        <view class="id-act">
          <view class="id-act-t">隐私脱敏</view>
          <view class="switch {{privacy ? 'on' : ''}}" bindtap="togglePrivacy"><view class="switch-knob"></view></view>
        </view>
      </view>
    </view>

    <!-- 声纹自我介绍 -->
    <view class="group">
      <view class="group-title">🎙 声纹自我介绍 · 最多 30 秒</view>
      <view class="card">
        <view class="rec-row">
          <!-- 波形 -->
          <view class="wave {{recording ? 'live' : ''}}">
            <view class="wave-bar" wx:for="{{bars}}" wx:key="*this" style="height:{{item * 56 + 8}}rpx"></view>
          </view>
          <view class="rec-sec t-mono">{{recording ? sec : (voice ? (voice.duration || '已录制') : '00')}}s</view>
        </view>

        <view class="rec-btns">
          <view class="btn btn-primary {{recording ? 'btn-disabled' : ''}}" wx:if="{{!recording && !playing}}" bindtap="startRecord">
            {{voice ? '重新录制' : '开始录制'}}
          </view>
          <view class="btn btn-danger" wx:if="{{recording}}" bindtap="stopRecord">停止并保存</view>

          <view class="btn btn-tint" wx:if="{{voice && !playing}}" bindtap="playVoice">▶ 播放</view>
          <view class="btn btn-gray" wx:if="{{playing}}" bindtap="stopVoice">■ 停止</view>
          <view class="btn btn-gray" wx:if="{{voice}}" bindtap="removeVoice">删除</view>
        </view>

        <view class="rec-tip" wx:if="{{voice}}">录制于 {{voice.date}} · 仅保存在本机</view>
        <view class="rec-tip" wx:else>录一段 30 秒自我介绍，面试前自己听一遍，比读十遍稿管用。</view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="group">
      <view class="btn btn-primary" bindtap="makeCard">生成名片长图</view>
      <view class="btn btn-gray" style="margin-top:20rpx" bindtap="copyContact">复制联系方式文本</view>
    </view>

    <view class="group">
      <view class="group-foot" style="margin:0">名片图会存成一张 1080 宽的高清图，可直接发给 HR 或打印成纸质名片。</view>
    </view>

    <view class="safe-bottom"></view>
  </view>

  <canvas type="2d" id="card" class="off-canvas"></canvas>
</view>
