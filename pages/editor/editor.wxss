/* editor.wxss */
.page { min-height: 100vh; background-color: #F2F2F7; position: relative; }
.ed-head { background-color: #F2F2F7; padding-bottom: 12rpx; position: relative; z-index: 5; }
.comp-bar { display: flex; align-items: center; padding: 18rpx 32rpx 6rpx; }
.comp-track { flex: 1; height: 10rpx; border-radius: 999rpx; background-color: rgba(120,120,128,0.16); overflow: hidden; }
.comp-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #007AFF, #34C759);
  transition: width .7s cubic-bezier(.32,.72,0,1); }
.comp-tx { font-size: 24rpx; color: rgba(60,60,67,0.5); margin-left: 18rpx; font-variant-numeric: tabular-nums; }

/* 头像 */
.ava-btn {
  width: 80rpx; height: 80rpx; border-radius: 50%; padding: 0; margin: 0;
  background-color: rgba(0,122,255,0.06); overflow: hidden; line-height: 1;
  border: 3rpx dashed rgba(0,122,255,0.35);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  transition: transform .2s cubic-bezier(.34,1.56,.64,1);
}
.ava-hover { transform: scale(0.94); }
.ava-btn::after { border: none; }
.ava-img { width: 80rpx; height: 80rpx; border-radius: 50%; }
.ava-ph { display: flex; align-items: center; justify-content: center; }
.ava-plus { width: 36rpx; height: 36rpx; border-radius: 50%; background-color: #007AFF;
  color: #FFFFFF; font-size: 26rpx; line-height: 32rpx; text-align: center; }
.ed-body { min-height: 60vh; }

/* 模块条目 */
.mod-item { display: flex; align-items: center; padding: 24rpx 30rpx; position: relative; }
.mod-item + .mod-item::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.mod-main { flex: 1; min-width: 0; }
.mod-title-row { display: flex; align-items: center; }
.mod-label { font-size: 32rpx; font-weight: 600; color: #000; }
.mod-label.dim { opacity: 0.42; }
.mod-sub { font-size: 24rpx; color: rgba(60,60,67,0.5); margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.mod-ops { display: flex; align-items: center; margin-left: 16rpx; }
.op {
  width: 58rpx; height: 58rpx; border-radius: 18rpx; margin-left: 10rpx;
  background-color: rgba(118,118,128,0.12); color: rgba(60,60,67,0.65);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
  transition: transform .16s cubic-bezier(.34,1.56,.64,1);
}
.op:active { transform: scale(0.88); }
.op.danger { background-color: rgba(255,59,48,0.12); color: #FF3B30; }

.add-row { min-height: 96rpx; }
.add-plus { width: 48rpx; height: 48rpx; border-radius: 50%; background-color: rgba(0,122,255,0.14);
  color: #007AFF; display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; margin-right: 20rpx; }

/* 体检条目 */
.issue { display: flex; align-items: flex-start; padding: 24rpx 30rpx; position: relative; }
.issue + .issue::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.issue-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-top: 12rpx; margin-right: 18rpx; flex-shrink: 0; }
.issue-tx { flex: 1; font-size: 27rpx; color: rgba(60,60,67,0.8); line-height: 1.5; }

.sheet-space { height: 40rpx; }
