/* insight.wxss */
.page { min-height: 100vh; background-color: #F2F2F7; }
.ins-head { background-color: #F2F2F7; position: relative; z-index: 5; padding-bottom: 12rpx; }
.tab-scroll { white-space: nowrap; margin: 18rpx 0 0; padding: 0 32rpx 4rpx; }
.ins-body { min-height: 60vh; }

.jd-row { display: flex; align-items: center; justify-content: flex-end; }
.jd-row .btn { margin-left: 16rpx; }

.score-card { display: flex; align-items: center; padding: 44rpx 36rpx; }
.score-tx { flex: 1; margin-left: 40rpx; min-width: 0; }

/* 体检明细 */
.check { display: flex; align-items: flex-start; padding: 22rpx 30rpx; position: relative; }
.check + .check::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.check-ic { width: 44rpx; height: 44rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; color: #FFF; }
.check-ic.pass { background-color: #34C759; }
.check-ic.fail { background-color: #FF9500; }
.check-body { flex: 1; min-width: 0; }
.check-title { font-size: 29rpx; }
.check-title.dim { color: rgba(60,60,67,0.45); }
.check-tip { font-size: 24rpx; color: rgba(60,60,67,0.55); margin-top: 6rpx; line-height: 1.5; }
.check-w { font-size: 22rpx; color: rgba(60,60,67,0.3); margin-left: 16rpx; font-variant-numeric: tabular-nums; }

/* 面试官问答 */
.q-item { padding: 26rpx 30rpx; position: relative; transition: background-color .2s ease; }
.q-item + .q-item::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.q-item.open { background-color: rgba(0,122,255,0.04); }
.q-head { display: flex; align-items: flex-start; }
.q-idx { width: 40rpx; height: 40rpx; border-radius: 12rpx; background-color: rgba(88,86,214,0.12);
  color: #5856D6; font-size: 22rpx; font-weight: 700; display: flex; align-items: center;
  justify-content: center; margin-right: 18rpx; flex-shrink: 0; }
.q-text { flex: 1; font-size: 28rpx; line-height: 1.55; }
.q-arrow { font-size: 34rpx; color: rgba(60,60,67,0.28); margin-left: 12rpx; line-height: 1; }
.q-more { margin: 20rpx 0 4rpx 58rpx; padding: 22rpx 24rpx; border-radius: 18rpx;
  background-color: rgba(118,118,128,0.1); }
.q-point-label { font-size: 20rpx; color: rgba(60,60,67,0.45); letter-spacing: 1rpx; }
.q-point { font-size: 26rpx; color: rgba(60,60,67,0.8); margin-top: 6rpx; line-height: 1.5; }
.q-src { font-size: 22rpx; color: rgba(60,60,67,0.4); margin-top: 12rpx; }

/* STAR 改写 */
.bl { padding: 24rpx 30rpx; position: relative; }
.bl + .bl::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.bl.on { background-color: rgba(0,122,255,0.05); }
.bl-host { font-size: 22rpx; color: #007AFF; margin-bottom: 6rpx; }
.bl-text { font-size: 27rpx; color: rgba(60,60,67,0.85); line-height: 1.5; }

.orig { padding: 30rpx; font-size: 27rpx; color: rgba(60,60,67,0.55); line-height: 1.6; }

.note { display: flex; align-items: flex-start; padding: 20rpx 30rpx; position: relative; }
.note + .note::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.note-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background-color: #FF9500;
  margin-top: 14rpx; margin-right: 18rpx; flex-shrink: 0; }
.note-tx { flex: 1; font-size: 26rpx; color: rgba(60,60,67,0.8); line-height: 1.5; }

.cand { padding: 26rpx 30rpx; position: relative; }
.cand + .cand::before { content: ""; position: absolute; left: 30rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.cand-tag { display: inline-block; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx;
  background-color: rgba(0,122,255,0.12); color: #007AFF; margin-bottom: 14rpx; }
.cand-text { font-size: 28rpx; line-height: 1.6; margin-bottom: 20rpx; }

/* ---------- AI 深度分析 ---------- */
.ai-setup { padding: 48rpx 40rpx; text-align: center; }
.ai-setup-ic { font-size: 72rpx; margin-bottom: 16rpx; }

.task-grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.task {
  width: 50%; padding: 8rpx;
}
.task > view {
  background-color: #FFFFFF; border-radius: 24rpx; padding: 22rpx 22rpx 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 6rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid transparent; min-height: 176rpx;
  transition: transform .2s cubic-bezier(.34,1.56,.64,1), border-color .2s ease;
}
.task.on > view { border-color: #5856D6; transform: translateY(-3rpx); }
.task-ic { font-size: 36rpx; }
.task-n { font-size: 27rpx; font-weight: 600; margin-top: 8rpx; }
.task-d { font-size: 21rpx; color: rgba(60,60,67,0.5); margin-top: 6rpx; line-height: 1.45; }

.st-line { display: flex; align-items: center; padding: 24rpx 28rpx; }
.st-line .st-dot { background-color: #34C759; }

.ai-err { padding: 26rpx 28rpx; border-left: 6rpx solid #FF3B30; }
.ai-err-t { font-size: 26rpx; color: #D5322C; line-height: 1.55; }

.ai-act { float: right; font-size: 24rpx; color: #007AFF; margin-left: 24rpx; font-weight: 400; }

.ai-result { padding: 28rpx 30rpx; }
.ai-result rich-text { display: block; }
