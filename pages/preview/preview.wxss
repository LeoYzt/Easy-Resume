/* preview.wxss */
.page { min-height: 100vh; background-color: #F2F2F7; }
.pv-head { background-color: #F2F2F7; position: relative; z-index: 5; padding-bottom: 14rpx; }
.tpl-scroll { white-space: nowrap; margin: 18rpx 0 0; padding: 0 32rpx 4rpx; }
.pv-body { min-height: 60vh; }

.paper-wrap { padding: 26rpx 32rpx 0; }
.paper {
  background-color: #FFFFFF;
  border-radius: 14rpx;
  padding: 62rpx 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05), 0 24rpx 60rpx rgba(0,0,0,0.09);
  position: relative;
  overflow: hidden;
}
.paper::before { content: ""; position: absolute; left: 0; top: 0; right: 0; height: 8rpx;
  background: linear-gradient(90deg, #007AFF, #5856D6); background: linear-gradient(90deg, var(--acc, #007AFF), #5856D6); }

.pages-hint { margin: 24rpx 32rpx 0; padding: 20rpx 28rpx; border-radius: 22rpx;
  background-color: rgba(52,199,89,0.12); color: #248A3D; font-size: 26rpx; text-align: center; }
.pages-hint.warn { background-color: rgba(255,149,0,0.14); color: #B25000; }

/* ---------- 基础排版 ---------- */
.p-head { padding-bottom: 26rpx; border-bottom: 2rpx solid rgba(60,60,67,0.14); }
.p-name { font-size: 52rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.15; }
.p-title { font-size: 30rpx; margin-top: 6rpx; color: #007AFF; color: var(--acc, #007AFF); font-weight: 500; }
.p-status {
  display: inline-block; font-size: 21rpx; padding: 4rpx 16rpx; border-radius: 999rpx;
  background-color: rgba(0,122,255,0.10); color: #007AFF; color: var(--acc, #007AFF);
  margin-top: 10rpx;
}
.p-contact { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.p-c { font-size: 24rpx; color: rgba(60,60,67,0.6); margin-right: 22rpx; margin-top: 6rpx; }

.p-sec { margin-top: 40rpx; }
.p-sec-t {
  font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; color: #007AFF; color: var(--acc, #007AFF);
  padding-bottom: 10rpx; border-bottom: 2rpx solid rgba(60,60,67,0.12); margin-bottom: 18rpx;
}
.p-item { margin-bottom: 24rpx; }
.p-row { display: flex; align-items: baseline; justify-content: space-between; }
.p-row-l { font-size: 30rpx; font-weight: 600; flex: 1; min-width: 0; padding-right: 20rpx; }
.p-row-r { font-size: 24rpx; color: rgba(60,60,67,0.55); flex-shrink: 0; font-variant-numeric: tabular-nums; }
.p-role { font-weight: 400; color: rgba(60,60,67,0.62); }
.p-row-sub { font-size: 24rpx; color: rgba(60,60,67,0.55); margin-top: 6rpx; line-height: 1.5; }
.p-summary { font-size: 26rpx; line-height: 1.7; color: rgba(60,60,67,0.85); }

.p-bullet { position: relative; padding-left: 26rpx; font-size: 26rpx; line-height: 1.68;
  color: rgba(60,60,67,0.88); margin-top: 6rpx; }
.p-bullet::before { content: ""; position: absolute; left: 6rpx; top: 18rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%; background-color: #007AFF; background-color: var(--acc, #007AFF); }

.p-skill { display: flex; margin-bottom: 14rpx; }
.p-skill-k { width: 180rpx; flex-shrink: 0; font-size: 27rpx; font-weight: 600; }
.p-skill-v { flex: 1; }
.p-tag { display: inline-block; font-size: 23rpx; padding: 5rpx 16rpx; border-radius: 999rpx;
  background-color: rgba(120,120,128,0.12); color: rgba(60,60,67,0.78); margin: 0 10rpx 10rpx 0; }

.p-foot { margin-top: 46rpx; font-size: 20rpx; color: rgba(60,60,67,0.32); text-align: center; }

/* ---------- 紧凑模式 ---------- */
.paper.compact .p-sec { margin-top: 28rpx; }
.paper.compact .p-item { margin-bottom: 16rpx; }
.paper.compact .p-bullet { line-height: 1.55; margin-top: 4rpx; }
.paper.compact .p-head { padding-bottom: 20rpx; }

/* ---------- 模板变体 ---------- */
/* 极简：居中头部、黑白灰 */
.paper.tpl-minimal .p-head { text-align: center; border-bottom: none; padding-bottom: 12rpx; }
.paper.tpl-minimal .p-contact { justify-content: center; }
.paper.tpl-minimal .p-name { font-size: 60rpx; font-weight: 300; letter-spacing: 2rpx; }
.paper.tpl-minimal .p-title { color: #6B6B70; color: var(--acc, #6B6B70); letter-spacing: 3rpx; font-size: 26rpx; }
.paper.tpl-minimal .p-sec-t { color: #000; text-transform: uppercase; font-size: 24rpx;
  border-bottom: 1rpx solid rgba(60,60,67,0.1); letter-spacing: 4rpx; }
.paper.tpl-minimal .p-bullet::before { background-color: #8A8A8E; }

/* 雅致：衬线 + 米色 */
.paper.tpl-elegant { background-color: #FDFBF8; }
.paper.tpl-elegant .p-name { font-family: "Songti SC", "Times New Roman", serif; font-size: 56rpx; }
.paper.tpl-elegant .p-sec-t { font-family: "Songti SC", "Times New Roman", serif; letter-spacing: 4rpx; }
.paper.tpl-elegant .p-head { text-align: center; }
.paper.tpl-elegant .p-contact { justify-content: center; }

/* 创意：色块头部 */
.paper.tpl-creative::before { height: 0; }
.paper.tpl-creative { padding-top: 0; }
.paper.tpl-creative .p-head {
  background: linear-gradient(135deg, #007AFF, #5856D6);
  background: linear-gradient(135deg, var(--acc, #007AFF), #5856D6);
  margin: -62rpx -56rpx 0; padding: 56rpx 56rpx 34rpx; color: #FFFFFF; border-bottom: none;
}
.paper.tpl-creative .p-name { color: #FFFFFF; }
.paper.tpl-creative .p-title { color: rgba(255,255,255,0.88); }
.paper.tpl-creative .p-c { color: rgba(255,255,255,0.82); }
.paper.tpl-creative .p-tag { background-color: rgba(120,120,128,0.1); }

/* 瑞士：网格 + 细 Rule */
.paper.tpl-swiss { padding: 52rpx 46rpx; }
.paper.tpl-swiss .p-head { border-bottom: 6rpx solid #000; padding-bottom: 20rpx; }
.paper.tpl-swiss .p-name { font-size: 56rpx; letter-spacing: -2rpx; }
.paper.tpl-swiss .p-title { color: #000; color: var(--acc, #000); font-weight: 700; letter-spacing: 1rpx; }
.paper.tpl-swiss .p-sec-t { color: #000; color: var(--acc, #000); border-bottom: 3rpx solid #000; }
.paper.tpl-swiss .p-bullet::before { background-color: #000; width: 10rpx; height: 10rpx; border-radius: 0; }

/* 时间轴：左侧竖线 */
.paper.tpl-timeline .p-sec-t { padding-left: 26rpx; }
.paper.tpl-timeline .p-item { position: relative; padding-left: 30rpx; border-left: 3rpx solid rgba(60,60,67,0.12); }
.paper.tpl-timeline .p-item::before { content: ""; position: absolute; left: -10rpx; top: 12rpx;
  width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #007AFF; background-color: var(--acc, #007AFF);
  box-shadow: 0 0 0 6rpx rgba(255,255,255,1); }
.paper.tpl-timeline .p-sec { padding-left: 4rpx; }

/* ---------- 底部操作栏 ---------- */
.pv-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
  background-color: rgba(255,255,255,0.86);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  border-top: 1rpx solid rgba(60,60,67,0.1);
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom, 0px));
}
.pv-bar-in { display: flex; align-items: center; }
.pv-btn { height: 92rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600; }
.pv-btn.main { flex: 1.5; background-color: #007AFF; color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0,122,255,0.3); }
.pv-btn.ghost { flex: 1; background-color: rgba(118,118,128,0.12); color: #007AFF; margin-right: 16rpx; }
.pv-btn:active { opacity: 0.72; transform: scale(0.98); }

.off-canvas { position: fixed; left: -9999px; top: -9999px; width: 1240px; height: 100px; }

.pv-space { height: calc(190rpx + env(safe-area-inset-bottom, 0px)); }

/* ---------- 只读访客提示条 ---------- */
.guest {
  display: flex; align-items: center;
  margin: 16rpx 32rpx 0; padding: 22rpx 24rpx;
  border-radius: 26rpx;
  background-color: rgba(88,86,214,0.08);
  border: 2rpx solid rgba(88,86,214,0.18);
  box-shadow: 0 4rpx 16rpx rgba(88,86,214,0.06);
}
.guest-ic {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; margin-right: 20rpx;
  background-color: rgba(88,86,214,0.14); display: flex; align-items: center; justify-content: center;
}
.guest-eye {
  width: 30rpx; height: 18rpx; border-radius: 18rpx / 50%;
  border: 3rpx solid #5856D6; position: relative;
}
.guest-eye::after {
  content: ""; position: absolute; left: 50%; top: 50%;
  width: 8rpx; height: 8rpx; margin: -4rpx 0 0 -4rpx;
  border-radius: 50%; background-color: #5856D6;
}
.guest-body { flex: 1; min-width: 0; }
.guest-title { font-size: 28rpx; font-weight: 600; color: #36349B; }
.guest-sub { font-size: 22rpx; color: rgba(60,60,67,0.55); margin-top: 4rpx; line-height: 1.45; }
.guest-btn {
  flex-shrink: 0; margin-left: 16rpx; padding: 14rpx 26rpx; border-radius: 999rpx;
  background-color: #5856D6; color: #FFFFFF; font-size: 24rpx; font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(88,86,214,0.28);
  transition: transform .18s cubic-bezier(.34,1.56,.64,1);
}
.guest-btn-hover { transform: scale(0.93); }
