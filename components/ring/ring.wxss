.ring-wrap { display: flex; align-items: center; justify-content: center; }
.ring-track { display: flex; align-items: center; justify-content: center; }
.ring-inner {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(0,0,0,0.02);
}
.ring-label {
  font-size: 46rpx; font-weight: 700; letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums; line-height: 1.05; color: #000;
}
.ring-sub { font-size: 20rpx; color: rgba(60,60,67,0.5); margin-top: 2rpx; }
