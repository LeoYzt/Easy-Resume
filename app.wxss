/* ============================================================
   Magic Resume · Apple Design System for WeChat Mini Program
   参照 iOS 17/18 Human Interface Guidelines
   ============================================================ */

page {
  background-color: #F2F2F7;
  color: #000000;
  font-family: -apple-system, "SF Pro Text", "SF Pro Display", "PingFang SC",
    "Helvetica Neue", "Helvetica", "Microsoft YaHei", sans-serif;
  font-size: 34rpx;
  line-height: 1.42;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view, text, input, textarea, button, scroll-view {
  box-sizing: border-box;
}

/* ---------- 排版阶梯（iOS Type Scale） ---------- */
.t-large-title { font-size: 68rpx; line-height: 1.12; font-weight: 700; letter-spacing: -1rpx; }
.t-title-1     { font-size: 56rpx; line-height: 1.16; font-weight: 700; letter-spacing: -0.8rpx; }
.t-title-2     { font-size: 44rpx; line-height: 1.2;  font-weight: 700; letter-spacing: -0.6rpx; }
.t-title-3     { font-size: 40rpx; line-height: 1.24; font-weight: 600; letter-spacing: -0.4rpx; }
.t-headline    { font-size: 34rpx; line-height: 1.28; font-weight: 600; }
.t-body        { font-size: 34rpx; line-height: 1.42; font-weight: 400; }
.t-callout     { font-size: 32rpx; line-height: 1.4;  font-weight: 400; }
.t-subhead     { font-size: 30rpx; line-height: 1.4;  font-weight: 400; }
.t-footnote    { font-size: 26rpx; line-height: 1.36; font-weight: 400; }
.t-caption     { font-size: 24rpx; line-height: 1.34; font-weight: 400; }
.t-mono        { font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }

.w-regular { font-weight: 400; }
.w-medium  { font-weight: 500; }
.w-semi    { font-weight: 600; }
.w-bold    { font-weight: 700; }

/* ---------- 语义色 ---------- */
.c-label        { color: #000000; }
.c-secondary    { color: rgba(60,60,67,0.60); }
.c-tertiary     { color: rgba(60,60,67,0.30); }
.c-quaternary   { color: rgba(60,60,67,0.18); }
.c-placeholder  { color: rgba(60,60,67,0.30); }

.c-blue    { color: #007AFF; }
.c-green   { color: #34C759; }
.c-indigo  { color: #5856D6; }
.c-orange  { color: #FF9500; }
.c-red     { color: #FF3B30; }
.c-pink    { color: #FF2D55; }
.c-purple  { color: #AF52DE; }
.c-teal    { color: #30B0C7; }

.bg-blue    { background-color: #007AFF; }
.bg-green   { background-color: #34C759; }
.bg-indigo  { background-color: #5856D6; }
.bg-orange  { background-color: #FF9500; }
.bg-red     { background-color: #FF3B30; }
.bg-pink    { background-color: #FF2D55; }
.bg-purple  { background-color: #AF52DE; }
.bg-teal    { background-color: #30B0C7; }

/* ---------- 布局容器 ---------- */
.screen { min-height: 100vh; background-color: #F2F2F7; padding-bottom: 200rpx; }
.pad-h  { padding-left: 32rpx; padding-right: 32rpx; }

/* 大标题导航区（iOS Large Title） */
.navbar-lg { padding: 24rpx 32rpx 8rpx; }
.navbar-lg .eyebrow { font-size: 24rpx; color: rgba(60,60,67,0.5); letter-spacing: 1rpx; margin-bottom: 4rpx; }

/* ---------- 分组卡片（iOS Inset Grouped） ---------- */
.group { margin: 28rpx 32rpx 0; }
.group-title {
  font-size: 26rpx; font-weight: 600; color: rgba(60,60,67,0.55);
  text-transform: none; margin: 0 24rpx 12rpx; letter-spacing: 0.4rpx;
}
.group-foot { font-size: 24rpx; color: rgba(60,60,67,0.45); margin: 12rpx 24rpx 0; line-height: 1.5; }

.card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 28rpx rgba(0,0,0,0.045);
}

/* 列表行 */
.row {
  display: flex; align-items: center;
  min-height: 108rpx;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  position: relative;
  transition: background-color .18s ease;
}
.row + .row::before {
  content: ""; position: absolute; left: 32rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16);
}
.row::after { content: none; }
.row.hair-full + .row.hair-full::before { left: 0; }
.row.tapped { background-color: #E5E5EA; }
.row-icon {
  width: 58rpx; height: 58rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: #FFFFFF; margin-right: 24rpx; flex-shrink: 0;
}
.row-body { flex: 1; min-width: 0; }
.row-title { font-size: 34rpx; color: #000000; }
.row-sub { font-size: 26rpx; color: rgba(60,60,67,0.5); margin-top: 4rpx; }
.row-value { font-size: 32rpx; color: rgba(60,60,67,0.5); max-width: 340rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }
.chev { width: 16rpx; height: 16rpx; border-top: 3rpx solid rgba(60,60,67,0.28);
  border-right: 3rpx solid rgba(60,60,67,0.28); transform: rotate(45deg); margin-left: 16rpx; flex-shrink: 0; }

/* 输入框行 —— 无缝融合在卡片里 */
.field { display: flex; align-items: center; min-height: 100rpx; padding: 0 32rpx; position: relative; }
.field + .field::before { content: ""; position: absolute; left: 32rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.field-label { width: 200rpx; flex-shrink: 0; font-size: 32rpx; color: #000; }
.field-input { flex: 1; font-size: 32rpx; color: #000; min-width: 0; }
.field-ph { color: rgba(60,60,67,0.3); }

/* 多行输入 */
.field-multi { padding: 24rpx 32rpx; position: relative; }
.field-multi + .field-multi::before { content: ""; position: absolute; left: 32rpx; right: 0; top: 0;
  height: 1rpx; background-color: rgba(60,60,67,0.16); }
.multi-area { width: 100%; font-size: 30rpx; line-height: 1.55; height: 160rpx; color: #000; }

/* ---------- 分段控件 UISegmentedControl ---------- */
.seg {
  display: inline-flex; padding: 4rpx; border-radius: 22rpx;
  background-color: rgba(118,118,128,0.12); width: fit-content;
}
.seg-scroll { display: inline-flex; padding: 4rpx; border-radius: 22rpx;
  background-color: rgba(118,118,128,0.12); }
.seg-item {
  padding: 12rpx 30rpx; border-radius: 18rpx; font-size: 28rpx;
  color: #000; transition: all .28s cubic-bezier(.32,.72,0,1); white-space: nowrap;
  flex-shrink: 0;
}
.seg-item.on {
  background-color: #FFFFFF; font-weight: 600;
  box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.12), 0 3rpx 1rpx rgba(0,0,0,0.04);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 100rpx; border-radius: 24rpx; font-size: 34rpx; font-weight: 600;
  transition: transform .18s cubic-bezier(.34,1.56,.64,1), opacity .18s ease;
}
.btn::after { border: none; }
.btn-press { transform: scale(0.965); opacity: 0.86; }
.btn-primary { background-color: #007AFF; color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0,122,255,0.28); }
.btn-danger  { background-color: #FF3B30; color: #FFFFFF; }
.btn-tint    { background-color: rgba(0,122,255,0.10); color: #007AFF; }
.btn-gray    { background-color: rgba(118,118,128,0.12); color: #007AFF; }
.btn-ghost   { background-color: #FFFFFF; color: #007AFF;
  border: 2rpx solid rgba(0,122,255,0.25); }
.btn-round   { border-radius: 999rpx; }
.btn-sm      { height: 72rpx; font-size: 28rpx; border-radius: 18rpx; padding: 0 28rpx; }
.btn-disabled{ opacity: 0.4; }

/* ---------- 标签 Chip ---------- */
.chip {
  display: inline-flex; align-items: center;
  padding: 8rpx 20rpx; border-radius: 999rpx; font-size: 24rpx;
  background-color: rgba(118,118,128,0.12); color: rgba(60,60,67,0.8); margin: 0 12rpx 12rpx 0;
}
.chip-blue   { background-color: rgba(0,122,255,0.12); color: #007AFF; }
.chip-green  { background-color: rgba(52,199,89,0.14); color: #248A3D; }
.chip-orange { background-color: rgba(255,149,0,0.16); color: #B25000; }
.chip-red    { background-color: rgba(255,59,48,0.12); color: #D5322C; }
.chip-purple { background-color: rgba(175,82,222,0.14); color: #8E44AD; }

/* ---------- iOS 开关 ---------- */
.switch { width: 102rpx; height: 62rpx; border-radius: 999rpx; background-color: rgba(120,120,128,0.16);
  position: relative; transition: background-color .28s cubic-bezier(.32,.72,0,1); flex-shrink: 0; }
.switch.on { background-color: #34C759; }
.switch-knob { position: absolute; top: 4rpx; left: 4rpx; width: 54rpx; height: 54rpx; border-radius: 50%;
  background-color: #FFFFFF; box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.15), 0 1rpx 1rpx rgba(0,0,0,0.16);
  transition: transform .28s cubic-bezier(.32,.72,0,1); }
.switch.on .switch-knob { transform: translateX(40rpx); }

/* ---------- 底部弹层 Sheet ---------- */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.4);
  z-index: 900; transition: opacity .34s cubic-bezier(.32,.72,0,1); opacity: 0; }
.mask.show { opacity: 1; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000;
  background-color: #F2F2F7;
  border-radius: 40rpx 40rpx 0 0;
  transform: translateY(102%);
  transition: transform .46s cubic-bezier(.32,.72,0,1);
  max-height: 88vh; display: flex; flex-direction: column;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.12);
}
.sheet.show { transform: translateY(0); }
.sheet-grab { width: 76rpx; height: 10rpx; border-radius: 999rpx;
  background-color: rgba(60,60,67,0.22); margin: 16rpx auto 6rpx; }
.sheet-head { display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 36rpx 20rpx; }
.sheet-body { flex: 1; overflow-y: auto; padding: 0 24rpx 24rpx; -webkit-overflow-scrolling: touch; }
.sheet-foot { padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom, 0px)); background-color: #F2F2F7; }
.link-btn { font-size: 34rpx; color: #007AFF; }
.link-btn.danger { color: #FF3B30; }

/* ---------- Hero 卡 / 渐变 ---------- */
.hero {
  margin: 20rpx 32rpx 0; padding: 36rpx; border-radius: 36rpx; color: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.14); position: relative; overflow: hidden;
}
.hero::after { content: ""; position: absolute; width: 420rpx; height: 420rpx; right: -140rpx; top: -180rpx;
  border-radius: 50%; background: rgba(255,255,255,0.14); }
.hero-title { font-size: 48rpx; font-weight: 700; letter-spacing: -0.6rpx; }
.hero-sub { font-size: 28rpx; opacity: 0.86; margin-top: 8rpx; }

/* ---------- 通用小件 ---------- */
.divider { height: 1rpx; background-color: rgba(60,60,67,0.16); }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.bar-track { height: 12rpx; border-radius: 999rpx; background-color: rgba(120,120,128,0.16); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; transition: width .8s cubic-bezier(.32,.72,0,1); }

.stat-card { flex: 1; background-color: #FFFFFF; border-radius: 28rpx; padding: 28rpx 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 28rpx rgba(0,0,0,0.045); }
.stat-num { font-size: 52rpx; font-weight: 700; letter-spacing: -1rpx; font-variant-numeric: tabular-nums; }
.stat-lbl { font-size: 24rpx; color: rgba(60,60,67,0.5); margin-top: 2rpx; }

/* 快捷四宫格 */
.quick-grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.quick-item { width: 25%; padding: 8rpx; }
.quick-box { background-color: #FFFFFF; border-radius: 26rpx; padding: 22rpx 0 18rpx; text-align: center;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 6rpx 20rpx rgba(0,0,0,0.04);
  transition: transform .18s cubic-bezier(.34,1.56,.64,1); }
.quick-box.press { transform: scale(0.94); }
.quick-ic { width: 76rpx; height: 76rpx; border-radius: 22rpx; margin: 0 auto 12rpx;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: #FFF; }
.quick-tx { font-size: 24rpx; color: rgba(60,60,67,0.75); }

/* 空状态 */
.empty { padding: 90rpx 60rpx; text-align: center; }
.empty-ic { font-size: 88rpx; opacity: 0.28; }
.empty-tx { font-size: 30rpx; color: rgba(60,60,67,0.45); margin-top: 20rpx; }

/* 徽章 / 成就 */
.badge-row { display: inline-flex; align-items: center; padding: 0 8rpx; }
.badge {
  width: 116rpx; text-align: center; flex-shrink: 0;
}
.badge-ic { width: 96rpx; height: 96rpx; border-radius: 50%; margin: 0 auto;
  display: flex; align-items: center; justify-content: center; font-size: 42rpx;
  color: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  transition: transform .22s cubic-bezier(.34,1.56,.64,1); }
.badge-tx { font-size: 22rpx; color: rgba(60,60,67,0.6); margin-top: 10rpx; }
.badge.locked .badge-ic { background-color: rgba(120,120,128,0.14) !important; color: rgba(60,60,67,0.22) !important;
  box-shadow: none; }
.badge.locked .badge-tx { color: rgba(60,60,67,0.3); }

.safe-bottom { padding-bottom: calc(48rpx + env(safe-area-inset-bottom, 0px)); }
/* tabBar 页底部留白：避免内容被固定标签栏遮住 */
.tab-bottom { height: calc(180rpx + env(safe-area-inset-bottom, 0px)); }
.hair { height: 1rpx; background-color: rgba(60,60,67,0.16); }
.hide { display: none; }
.fade-in { animation: fadeUp .42s cubic-bezier(.32,.72,0,1) both; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: none; } }
.pop-in { animation: popIn .46s cubic-bezier(.34,1.56,.64,1) both; }
@keyframes popIn { from { opacity: 0; transform: scale(.9); } to { opacity: 1; transform: none; } }
